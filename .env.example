ENVIRONMENT=development
SERVICE_PORT=8000

DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/appdb

# Redis Streams
REDIS_STREAM_URL=redis://localhost:6379/1
STREAM_NAME=order.events
CONSUMER_GROUP=order_service_v1
STREAM_POLL_INTERVAL_MS=1000

# Consumer reliability
CONSUMER_BATCH_SIZE=10
CONSUMER_MAX_RETRIES=3
CONSUMER_RETRY_BACKOFF_MS=500
CONSUMER_CLAIM_MIN_IDLE_MS=60000
DLQ_STREAM_NAME=

# Outbox relay
RELAY_ENABLED=true
OUTBOX_POLL_INTERVAL_MS=200
OUTBOX_BATCH_SIZE=20
OUTBOX_RETRY_BACKOFF_MS=500
OUTBOX_MAX_BACKOFF_MS=30000
OUTBOX_RETENTION_HOURS=24
OUTBOX_SWEEP_INTERVAL_S=300

# Logging
LOG_LEVEL=INFO
JSON_LOGS=false

# OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_ENDPOINT_ENABLE_FALLBACK=False